# Copy to .env and edit. Never commit .env.
# Demo deployment: authentication is disabled.
# Comma-separated allowed dashboard origins (CORS).
SKYGUARD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000
# Storage / model / station registry / replay scenarios (defaults shown).
SKYGUARD_DB=data/skyguard.db
SKYGUARD_MODEL_DIR=artifacts/final_model
SKYGUARD_STATIONS=data/processed/stations.json
# Per-client write requests per minute (simple in-memory limiter).
SKYGUARD_WRITE_RATE_PER_MIN=600
